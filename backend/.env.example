# Copy this file to .env.local for local overrides (never commit .env.local).
# In preprod/prod these are supplied by the environment (see infra/preprod|prod/.env.example).

# prod | dev | test
APP_ENV=prod

# Symfony app secret, used for CSRF tokens, signed URIs, etc. Generate with:
#   php -r 'echo bin2hex(random_bytes(16));'
APP_SECRET=changeme

# postgresql://<user>:<password>@<host>:5432/<db>?serverVersion=16&charset=utf8
DATABASE_URL="postgresql://nanko:changeme@127.0.0.1:5432/nanko?serverVersion=16&charset=utf8"
