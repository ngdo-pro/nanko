# Copy to .env.local for local dev (gitignored).
# Matches docker-compose.yml defaults.

DATABASE_URL=postgres://nanko:nanko@localhost:5432/nanko
TEST_DATABASE_URL=postgres://nanko:nanko@localhost:5432/nanko_test

# Optional: unset to disable OpenTelemetry tracing entirely.
# When set, run `docker compose up jaeger` and view traces at http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
