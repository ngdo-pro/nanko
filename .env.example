# Copy to .env.local for local dev (gitignored).
# Matches docker-compose.yml defaults.

DATABASE_URL=postgres://nanko:nanko@localhost:5432/nanko
TEST_DATABASE_URL=postgres://nanko:nanko@localhost:5432/nanko_test

# Set by default: OpenTelemetry tracing is on. Run `docker compose up jaeger`
# alongside it and view traces at http://localhost:16686. Unset to disable
# tracing entirely — see src/instrumentation.ts.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
