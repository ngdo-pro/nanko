# SigNoz HTTP Basic Auth for Caddy gateway (signoz.nanko.dev)
SIGNOZ_BASICAUTH_USER=admin
# Generate bcrypt hash with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
SIGNOZ_BASICAUTH_HASH=

# SigNoz Superadmin Account (auto-provisioned on initial boot)
SIGNOZ_ADMIN_EMAIL=
SIGNOZ_ADMIN_PASSWORD=
SIGNOZ_ADMIN_NAME="Nanko Admin"
