# SigNoz Superadmin Account (auto-provisioned on initial boot)
SIGNOZ_ADMIN_EMAIL=
SIGNOZ_ADMIN_PASSWORD=
SIGNOZ_ADMIN_NAME="Nanko Admin"

# ClickHouse Authentication (SHA256 hex for clickhouse-users.xml, clear for clients)
CLICKHOUSE_DEFAULT_PASSWORD_SHA256=
CLICKHOUSE_SIGNOZ_PASSWORD=
CLICKHOUSE_SIGNOZ_PASSWORD_SHA256=
CLICKHOUSE_PLAUSIBLE_PASSWORD_SHA256=

# Caddy Basic Auth for SigNoz UI (bcrypt hash via caddy hash-password)
SIGNOZ_BASICAUTH_HASH=
