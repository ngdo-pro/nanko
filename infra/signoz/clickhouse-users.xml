<clickhouse>
    <profiles>
        <default>
            <allow_experimental_object_type>1</allow_experimental_object_type>
            <enable_json_type>1</enable_json_type>
        </default>
    </profiles>
    <users>
        <default>
            <password remove="1"/>
            <password_sha256_hex from_env="CLICKHOUSE_DEFAULT_PASSWORD_SHA256"/>
            <networks>
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
        <signoz>
            <password_sha256_hex from_env="CLICKHOUSE_SIGNOZ_PASSWORD_SHA256"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT ALL ON *.*</query>
            </grants>
        </signoz>
        <plausible>
            <password_sha256_hex from_env="CLICKHOUSE_PLAUSIBLE_PASSWORD_SHA256"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>0</access_management>
            <allow_databases>
                <database>plausible_events_db</database>
            </allow_databases>
        </plausible>
    </users>
</clickhouse>
